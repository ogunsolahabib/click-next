{
  "manifest_version": 3,
  "name": "Auto Next Lesson",
  "version": "1.0",
  "description": "Automatically clicks Next Lesson when the countdown timer hits 00:00:00.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://member.getdefensive.com/*"
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Turn Auto Next Lesson on/off (same as the popup toggle)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://member.getdefensive.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}